*{box-sizing:border-box}body{margin:0;font:1rem/1.6 system-ui,sans-serif;background:#fff;color:#202124}header,main,footer,.skip{display:block;width:92%;max-width:68rem;margin:auto;padding:1rem 0}h1,h2,h3{line-height:1.25;overflow-wrap:anywhere}nav,.actions{display:flex;flex-wrap:wrap;gap:1rem}nav a{padding:.5rem}a{color:#174ea6}a[aria-current]{font-weight:bold;text-decoration-thickness:3px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,17rem),1fr));gap:1rem}.card{border:1px solid #747775;border-radius:.5rem;padding:1rem;overflow-wrap:anywhere}.card h3{margin-top:0}.controls{max-width:36rem}label{display:block;margin-top:.5rem}input:not([type=checkbox]),select{display:block;max-width:100%;width:100%;padding:.6rem;font:inherit}#stage{max-width:22rem}button{padding:.6rem 1rem;margin-block:.5rem;font:inherit;border:2px solid #174ea6;background:#174ea6;color:white;border-radius:.3rem;cursor:pointer}button[aria-pressed=true]{text-decoration:underline;outline:2px solid #202124;outline-offset:2px}:focus-visible{outline:3px solid #a14300;outline-offset:4px}footer{border-top:1px solid #747775;margin-top:2rem}@media(prefers-color-scheme:dark){body{background:#202124;color:#f1f3f4}a{color:#aecbfa}input,select{background:#303134;color:#f1f3f4}button{background:#aecbfa;color:#202124;border-color:#aecbfa}button[aria-pressed=true]{outline-color:#f1f3f4}:focus-visible{outline-color:#fbbc04}}
