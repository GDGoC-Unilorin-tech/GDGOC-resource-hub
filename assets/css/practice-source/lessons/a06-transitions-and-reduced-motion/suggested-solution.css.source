.project-link { display: inline-block; padding: 1rem; border: 2px solid currentColor; }
.project-link:focus-visible { outline: 3px solid #174ea6; outline-offset: 4px; }
@media (prefers-reduced-motion: no-preference) {
  .project-link { transition: transform 120ms ease-out; }
  .project-link:hover, .project-link:focus-visible { transform: translateY(-1px); }
}
